# Maximum Overdrive configuration. Copy to .env and fill in what you need; everything is optional
# except MAX_ORIGIN outside dev mode. With Docker Compose, .env is read automatically.

# ---------- Server ----------
# The address people open, without a trailing slash (and without MAX_BASE_PATH). Used for the request-origin
# check, secure cookies (https) and links. Required unless MAX_DEV_MODE=1.
MAX_ORIGIN=http://localhost:4317
# Port to listen on (with Docker Compose: the port published on the host).
PORT=4317
# Address to listen on. 127.0.0.1 (default) when a reverse proxy runs on the same machine; Docker sets 0.0.0.0.
# MAX_HOST=127.0.0.1
# Serve under a sub-path, e.g. /max when the site is https://example.com/max/.
# MAX_BASE_PATH=
# Where the SQLite database and uploaded photos live (Docker: the max-data volume).
# MAX_DATA_DIR=data
# Time zone for server-side dates when a person's phone hasn't reported one yet, e.g. Europe/Lisbon.
# MAX_TIMEZONE=
# Local development only: http://localhost, no origin setup, sign-up codes printed to the console.
# Never enable in production.
# MAX_DEV_MODE=1

# ---------- Accounts ----------
# Who can create an account: invite (a partner's invite code is needed; the default), open (anyone who can reach
# the site) or closed (only `node server.mjs set-password` on the server). The first account can always be
# created from the app and becomes the admin.
MAX_SIGNUP=invite
# Show "Who's here?" (every account's name and photo) on the login screen instead of a login form. On by default
# only behind the Tailscale gate and in dev mode. 1 = always, 0 = never.
# MAX_ACCOUNT_PICKER=
# Tailscale gate: only these Tailscale logins (comma-separated) can reach the app at all, via the
# Tailscale-User-Login header that `tailscale serve` adds. Leave empty when not using Tailscale.
# MAX_ALLOWED_LOGIN=you@example.com,partner@example.com
# Behind a reverse proxy on the same machine, set to 1 so per-IP limits see the client's address (X-Forwarded-For).
# Never set it when the server can be reached without the proxy: the header could then be made up.
# MAX_TRUST_PROXY=1
# Sign-ups per IP address per hour (failed logins and code entries are limited per IP too).
# MAX_SIGNUPS_PER_HOUR=10
# Photos and files each account can store, in MB (0 = no limit).
# MAX_USER_STORAGE_MB=1024

# ---------- Running it for other people (see docs/hosting.md) ----------
# Shown on the built-in /privacy and /terms pages.
# MAX_OPERATOR=Your name
# MAX_CONTACT_EMAIL=you@example.com
# How long your backups keep deleted data, in days (shown on /privacy).
# MAX_BACKUP_DAYS=30
# Minimum age to use the service (default 16).
# MAX_MIN_AGE=16
# Your own policy pages instead of the built-in ones.
# MAX_PRIVACY_URL=https://example.com/privacy
# MAX_TERMS_URL=https://example.com/terms

# ---------- Email (sign-up codes and password resets) ----------
# Any SMTP server, as a URL. Examples:
#   smtps://you%40gmail.com:app-password@smtp.gmail.com:465      (Gmail with an app password)
#   smtps://resend:re_xxxxxxxx@smtp.resend.com:465                 (Resend)
#   smtp://user:password@smtp-relay.brevo.com:587                  (Brevo)
# URL-encode special characters in the user and password (@ is %40). Without email, sign-up still works but
# nobody can confirm an address or reset a forgotten password from the app.
# MAX_SMTP_URL=
# The sender. Defaults to the SMTP user.
# MAX_MAIL_FROM=MAX <no-reply@example.com>
# Write each mail as a JSON file in this folder instead of sending it (testing).
# MAX_MAIL_OUTBOX=

# ---------- Notifications ----------
# Contact for the Web Push service (a mailto: or your site's https URL). Defaults to MAX_ORIGIN when it is https.
# MAX_PUSH_SUBJECT=mailto:you@example.com

# ---------- Optional features ----------
# Which optional parts are on for everyone: vault (PIN-locked hidden photos and journal lock) and coach
# (M.A.X., the AI coach). Default: vault,coach. Leave one out to turn it off.
# MAX_FEATURES=vault,coach

# ---------- M.A.X. coach (AI) ----------
# Off unless a model is configured. Two ways:
# 1) Any OpenAI-compatible API (Ollama, LM Studio, a llama.cpp server, Groq, OpenRouter, OpenAI, Gemini's
#    OpenAI-compatible endpoint...). The coach sends the person's goals and notes for today to it.
# MAX_COACH_URL=http://127.0.0.1:11434/v1
# MAX_COACH_API_KEY=
# MAX_COACH_MODEL_NAME=llama3.2:3b
# Set to 1 when MAX_COACH_URL is a llama.cpp server, to use its per-slot prompt caching.
# MAX_COACH_LLAMACPP=
# 2) Or let the server start llama.cpp itself (a llama-server binary and a GGUF model on this machine).
# MAX_COACH_LLAMA_SERVER=/opt/llama.cpp/llama-server
# MAX_COACH_MODEL=/opt/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
# MAX_COACH_PORT=8097
# MAX_COACH_THREADS=3
# Unload the local model after this many idle seconds (0 = keep it loaded).
# MAX_COACH_IDLE_SECONDS=0
