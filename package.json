{
  "name": "maximum-overdrive",
  "version": "0.1.0",
  "description": "Self-hosted personal tracker for goals, habits and streaks, with an optional private journal, a shared journal for couples, and an optional AI coach.",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-selfhost.mjs",
    "start": "node --env-file-if-exists=.env selfhost-dist/server.mjs",
    "dev": "npm run build && node --env-file-if-exists=.env selfhost-dist/server.mjs",
    "test": "node tests/selfhost.mjs && node tests/accounts.mjs && node tests/spaces.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern selfhost-dist",
    "build:selfhost": "node scripts/build-selfhost.mjs",
    "start:selfhost": "node selfhost-dist/server.mjs",
    "test:selfhost": "node tests/selfhost.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
